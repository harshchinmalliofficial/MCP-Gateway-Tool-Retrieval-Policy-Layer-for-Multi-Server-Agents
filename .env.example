# Copy to .env and fill in ONE key. The gateway reads these; .env is gitignored
# so keys never land in the repo.

# Preferred: Groq (fast, free tier) -> https://console.groq.com/keys
GROQ_API_KEY=

# Fallback: Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Provider selector: groq | gemini | auto | simulated   (default: auto)
MCP_GATEWAY_PROVIDER=auto

# --- optional overrides ---
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-flash-lite-latest
# RETRIEVAL_TOP_K=5
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM_PACE_SECONDS=3          # pause between LLM calls to respect free-tier RPM caps
